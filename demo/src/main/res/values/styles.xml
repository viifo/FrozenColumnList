<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AutoSizeNumberText">
        <item name="android:gravity">center_vertical</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">1px</item>
        <item name="android:lines">1</item>
    </style>

    <style name="SymmetricQuoteCellBase">
        <item name="android:layout_width">86dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="SymmetricQuoteHeaderCell" parent="SymmetricQuoteCellBase">
        <item name="android:textColor">#666666</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SymmetricQuoteFrozenHeaderCell" parent="SymmetricQuoteHeaderCell">
        <item name="android:layout_width">96dp</item>
        <item name="android:background">@color/white</item>
        <item name="android:elevation">8dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SymmetricQuoteItemCell" parent="SymmetricQuoteCellBase">
        <item name="android:layout_height">48dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SymmetricQuoteFrozenItemCell" parent="SymmetricQuoteItemCell">
        <item name="android:layout_width">96dp</item>
        <item name="android:background">@color/white</item>
        <item name="android:elevation">8dp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
